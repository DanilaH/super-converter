---
import {
  canonicalPathFor,
  isPlaceholderSite,
  resolveSiteOrigin,
  type SiteMetadataKey,
} from "@/config/site";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { contentFor } from "@/i18n/content";
import {
  DEFAULT_LOCALE,
  localeConfigFor,
  type ActiveLocale,
} from "@/i18n/locales";
import "../styles/global.css";

interface Props {
  metadataKey: SiteMetadataKey;
  locale?: ActiveLocale;
}

const { metadataKey, locale = DEFAULT_LOCALE } = Astro.props;
const content = contentFor(locale);
const metadata = content.metadata[metadataKey];
const localeConfig = localeConfigFor(locale);
const site = resolveSiteOrigin(Astro.site);
const noIndex = metadataKey === "notFound" || isPlaceholderSite(site);
const canonicalUrl =
  metadataKey === "notFound"
    ? null
    : new URL(canonicalPathFor(metadataKey, locale), site).href;
const websiteStructuredData =
  locale === "en" && metadataKey === "home"
    ? JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        url: new URL("/", site).href,
        name: content.siteName,
      })
    : null;
---

<!doctype html>
<html lang={localeConfig.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{metadata.title}</title>
    <meta name="description" content={metadata.description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:title" content={metadata.title} />
    <meta property="og:description" content={metadata.description} />
    <meta property="og:type" content="website" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content={content.siteName} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}
    {
      websiteStructuredData && (
        <script
          is:inline
          type="application/ld+json"
          set:html={websiteStructuredData}
        />
      )
    }
  </head>
  <body class="shell">
    <SiteHeader locale={locale} content={content} />
    <main class="main">
      <slot />
    </main>
    <SiteFooter locale={locale} content={content} />
  </body>
</html>
