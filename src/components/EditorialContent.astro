---
import { englishContent } from "@/content/en";

const { editorial } = englishContent;
---

<section class="editorial">
  <section class="editorial-section">
    <h2>{editorial.howToHeading}</h2>
    <ol>
      {editorial.howToSteps.map((step) => <li>{step}</li>)}
    </ol>
  </section>

  <section class="editorial-section">
    <h2>{editorial.resultsHeading}</h2>
    <p>{editorial.resultsIntro}</p>
    <dl>
      {
        editorial.resultsItems.map((item) => (
          <>
            <dt>{item.term}</dt>
            <dd>{item.description}</dd>
          </>
        ))
      }
    </dl>
  </section>

  <section class="editorial-section">
    <h2>{editorial.commonUsesHeading}</h2>
    <p>{editorial.commonUsesIntro}</p>
    <ul>
      {editorial.commonUsesItems.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="editorial-section">
    <h2>{editorial.dataHeading}</h2>
    <p>{editorial.dataParagraph}</p>
    <ul>
      {editorial.dataItems.map((item) => <li>{item}</li>)}
    </ul>
    <p>
      <a href="/privacy">{editorial.dataLinkLabel}</a>
    </p>
  </section>

  <section class="editorial-section">
    <h2>{editorial.faqHeading}</h2>
    {
      editorial.faqItems.map((item) => (
        <>
          <h3>{item.question}</h3>
          <p>{item.answer}</p>
        </>
      ))
    }
  </section>
</section>

<style>
  .editorial {
    max-width: var(--container-editorial);
    padding-block: var(--space-6) var(--space-7);
  }

  .editorial-section + .editorial-section {
    margin-block-start: var(--space-7);
  }

  .editorial-section > :last-child {
    margin-block-end: 0;
  }

  .editorial h2 {
    margin-block: 0 var(--space-4);
    font-size: var(--font-size-h2-mobile);
    line-height: var(--line-height-h2-mobile);
    font-weight: var(--font-weight-h2);
  }

  @media (min-width: 760px) {
    .editorial h2 {
      font-size: var(--font-size-h2);
      line-height: var(--line-height-h2);
    }
  }

  .editorial h3 {
    margin-block: var(--space-5) var(--space-2);
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    font-weight: var(--font-weight-h3);
  }

  .editorial p {
    margin-block: 0 var(--space-4);
  }

  .editorial ol,
  .editorial ul {
    margin-block: 0 var(--space-4);
    padding-inline-start: var(--space-5);
  }

  .editorial li + li {
    margin-block-start: var(--space-2);
  }

  .editorial dl {
    margin-block: 0 var(--space-4);
  }

  .editorial dt {
    font-weight: var(--font-weight-control);
  }

  .editorial dd {
    margin-inline-start: 0;
    color: var(--color-text-secondary);
  }

  .editorial dd + dt {
    margin-block-start: var(--space-4);
  }
</style>
