---
import { randomizeListContent } from "@/content/randomize-list";

const { tool } = randomizeListContent;
---

<section
  data-randomize-tool
  aria-labelledby="randomize-tool-heading"
  data-label-item={tool.item}
  data-label-items={tool.items}
  data-label-empty-result={tool.emptyResult}
  data-label-ready-result={tool.readyResult}
  data-label-no-effective-items={tool.noEffectiveItems}
  data-label-randomize={tool.randomize}
  data-label-copy={tool.copy}
  data-label-copied={tool.copied}
  data-label-copy-error={tool.copyError}
  data-label-replace-example-confirmation={tool.replaceExampleConfirmation}
>
  <h2 id="randomize-tool-heading" class="visually-hidden">{tool.heading}</h2>

  <div class="input-section">
    <div class="input-toolbar">
      <label for="randomize-input">{tool.listLabel}</label>
      <div class="input-actions">
        <button type="button" class="example-button" data-load-example disabled>
          {tool.loadExample}
        </button>
        <button type="button" class="text-button" data-clear-list disabled>
          {tool.clear}
        </button>
      </div>
    </div>

    <textarea
      id="randomize-input"
      name="randomize-input"
      data-list-input
      rows="10"
      placeholder={tool.pastePlaceholder}
      spellcheck="false"></textarea>
  </div>

  <div class="controls">
    <fieldset class="options">
      <legend class="visually-hidden">{tool.options}</legend>
      <span class="options-label" aria-hidden="true">{tool.options}</span>
      <label class="option">
        <input type="checkbox" data-option-trim-whitespace checked />
        {tool.trimWhitespace}
      </label>
      <label class="option">
        <input type="checkbox" data-option-ignore-empty-lines checked />
        {tool.ignoreEmptyLines}
      </label>
    </fieldset>

    <button type="button" class="primary-action" data-randomize-list disabled>
      {tool.randomize}
    </button>
  </div>

  <section class="result-section" aria-label={tool.resultLabel}>
    <div class="result-toolbar">
      <p class="result-title">
        <span>{tool.resultLabel}</span>
        <span aria-hidden="true">·</span>
        <span data-result-count>0 {tool.items}</span>
      </p>
      <div class="result-actions">
        <button type="button" class="action" data-copy-result disabled>
          {tool.copy}
        </button>
        <button type="button" class="action" data-download-result disabled>
          {tool.download}
        </button>
      </div>
    </div>

    <div class="viewer-shell">
      <p data-empty-result>{tool.emptyResult}</p>
      <pre class="viewer" data-result-viewer tabindex="0" hidden></pre>
    </div>
    <p
      class="local-feedback"
      data-local-feedback
      role="status"
      aria-live="polite"
      aria-atomic="true"
    >
    </p>
  </section>

  <noscript>
    <p class="noscript">{tool.noscript}</p>
  </noscript>
</section>

<script>
  import { mountRandomizeTool } from "../scripts/randomize-tool";

  mountRandomizeTool();
</script>

<style>
  section[data-randomize-tool] {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-2);
    padding: var(--space-4);
    border: var(--border-default);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .input-toolbar,
  .result-toolbar,
  .controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .input-toolbar {
    min-height: 36px;
    margin-bottom: var(--space-2);
  }

  .input-toolbar > label {
    color: var(--color-text-secondary);
    font-size: var(--font-size-ui-label);
    line-height: var(--line-height-ui-label);
    font-weight: var(--font-weight-ui-label);
    letter-spacing: var(--letter-spacing-ui-label);
    text-transform: uppercase;
  }

  .input-actions,
  .result-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  textarea {
    display: block;
    width: 100%;
    height: clamp(160px, 19vh, 192px);
    min-height: 144px;
    padding: var(--space-3);
    border: var(--border-default);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--font-size-result-data);
    line-height: var(--line-height-result-data);
    resize: vertical;
  }

  textarea:hover,
  textarea:focus {
    border-color: var(--color-border-strong);
  }

  .controls {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    background: var(--color-surface-muted);
  }

  .options {
    display: flex;
    flex: 1 1 auto;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .options-label {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-secondary);
    line-height: var(--line-height-body-secondary);
    font-weight: var(--font-weight-control);
  }

  .option {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-control);
    line-height: var(--line-height-control);
    font-weight: var(--font-weight-control);
  }

  .option input {
    width: 16px;
    height: 16px;
    margin: 0;
    accent-color: var(--color-accent);
  }

  .primary-action {
    flex: none;
    min-width: 112px;
    min-height: 36px;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-surface);
    font-size: var(--font-size-control);
    line-height: var(--line-height-control);
    font-weight: var(--font-weight-control);
  }

  .primary-action:not(:disabled):hover {
    border-color: var(--color-accent-hover);
    background: var(--color-accent-hover);
  }

  .result-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: var(--border-default);
  }

  .result-toolbar {
    min-height: 36px;
  }

  .result-title {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-1);
    margin: 0;
    font-size: var(--font-size-control);
    line-height: var(--line-height-control);
    font-weight: var(--font-weight-control);
  }

  .viewer-shell {
    width: 100%;
    height: clamp(128px, 16vh, 168px);
    overflow: auto;
    border: var(--border-default);
    border-radius: var(--radius-md);
    background: var(--color-surface-muted);
  }

  .viewer-shell > p {
    margin: 0;
    padding: var(--space-3);
    color: var(--color-text-secondary);
  }

  .viewer {
    min-width: max-content;
    margin: 0;
    padding: var(--space-3);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--font-size-result-data);
    line-height: var(--line-height-result-data);
    white-space: pre;
  }

  button {
    cursor: pointer;
  }

  button:disabled {
    cursor: default;
    opacity: 0.5;
  }

  .example-button,
  .text-button {
    min-height: 32px;
    padding: 0;
    border: 0;
    background: transparent;
    font-size: var(--font-size-control);
    line-height: var(--line-height-control);
    font-weight: var(--font-weight-control);
  }

  .example-button {
    color: var(--color-accent);
  }

  .text-button {
    color: var(--color-text-secondary);
  }

  .example-button:not(:disabled):hover,
  .text-button:not(:disabled):hover {
    color: var(--color-accent-hover);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .action {
    min-height: 36px;
    padding: var(--space-1) var(--space-3);
    border: var(--border-default);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--font-size-control);
    line-height: var(--line-height-control);
    font-weight: var(--font-weight-control);
  }

  .action:not(:disabled):hover {
    border-color: var(--color-border-strong);
    background: var(--color-surface-muted);
  }

  .local-feedback {
    min-height: var(--line-height-body-secondary);
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-secondary);
    line-height: var(--line-height-body-secondary);
  }

  .local-feedback[data-state="error"] {
    color: var(--color-danger);
  }

  .noscript {
    margin: 0;
    color: var(--color-text-secondary);
  }

  @media (max-width: 559px) {
    .controls {
      align-items: stretch;
      flex-direction: column;
    }

    .primary-action {
      width: 100%;
    }
  }

  @media (pointer: coarse) {
    .option,
    .example-button,
    .text-button,
    .primary-action,
    .action {
      min-height: 44px;
    }
  }
</style>
