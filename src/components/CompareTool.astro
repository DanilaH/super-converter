---
import { englishContent } from "@/content/en";
import { DEFAULT_COMPARE_OPTIONS } from "@/features/compare-lists/model/defaults";

const { compare } = englishContent;
const options = DEFAULT_COMPARE_OPTIONS;

const resultViews = [
  {
    value: "differences",
    id: "tab-differences",
    label: compare.differences,
    selected: true,
  },
  { value: "onlyA", id: "tab-only-a", label: compare.onlyA, selected: false },
  { value: "onlyB", id: "tab-only-b", label: compare.onlyB, selected: false },
  {
    value: "matches",
    id: "tab-matches",
    label: compare.matches,
    selected: false,
  },
  { value: "all", id: "tab-all", label: compare.all, selected: false },
] as const;
---

<section
  data-compare-tool
  aria-labelledby="compare-tool-heading"
  data-label-row={compare.row}
  data-label-rows={compare.rows}
  data-label-item={compare.item}
  data-label-items={compare.items}
  data-label-no-differences={compare.noDifferences}
  data-label-same-values={compare.sameValues}
  data-label-no-matches={compare.noMatches}
  data-label-copy={compare.copy}
  data-label-copied={compare.copied}
  data-label-copy-error={compare.copyError}
  data-label-replace-example-confirmation={compare.replaceExampleConfirmation}
>
  <div class="tool-heading">
    <h2 id="compare-tool-heading" class="visually-hidden">{compare.heading}</h2>
    <button type="button" class="example-button" data-load-example disabled>
      {compare.loadExample}
    </button>
  </div>

  <div class="lists">
    <div class="list">
      <label for="list-a">{compare.listA}</label>
      <textarea
        id="list-a"
        name="list-a"
        data-list-a
        rows="10"
        placeholder={compare.pastePlaceholder}
        spellcheck="false"></textarea>
      <div class="list-footer">
        <output for="list-a" data-list-a-count>0 {compare.rows}</output>
        <button type="button" class="text-button" data-clear-list-a disabled>
          {compare.clear}
        </button>
      </div>
    </div>

    <button
      type="button"
      class="secondary swap"
      data-swap-lists
      disabled
      aria-label={compare.swap}
    >
      <span class="swap-mark" aria-hidden="true">⇄</span>
      <span class="swap-label">{compare.swap}</span>
    </button>

    <div class="list">
      <label for="list-b">{compare.listB}</label>
      <textarea
        id="list-b"
        name="list-b"
        data-list-b
        rows="10"
        placeholder={compare.pastePlaceholder}
        spellcheck="false"></textarea>
      <div class="list-footer">
        <output for="list-b" data-list-b-count>0 {compare.rows}</output>
        <button type="button" class="text-button" data-clear-list-b disabled>
          {compare.clear}
        </button>
      </div>
    </div>
  </div>

  <fieldset data-compare-options class="options">
    <legend class="visually-hidden">{compare.comparisonOptions}</legend>
    <span class="options-label" aria-hidden="true">
      {compare.comparisonOptions}
    </span>
    <label class="option">
      <input
        type="checkbox"
        id="option-trim-whitespace"
        name="trim-whitespace"
        data-option-trim-whitespace
        checked={options.trimWhitespace}
      />
      {compare.trimWhitespace}
    </label>
    <label class="option">
      <input
        type="checkbox"
        id="option-ignore-empty-lines"
        name="ignore-empty-lines"
        data-option-ignore-empty-lines
        checked={options.ignoreEmptyLines}
      />
      {compare.ignoreEmptyLines}
    </label>
    <label class="option">
      <input
        type="checkbox"
        id="option-ignore-case"
        name="ignore-case"
        data-option-ignore-case
        checked={options.ignoreCase}
      />
      {compare.ignoreCase}
    </label>
    <label class="option">
      <input
        type="checkbox"
        id="option-remove-duplicates"
        name="remove-duplicates"
        data-option-remove-duplicates
        checked={options.removeDuplicates}
      />
      {compare.removeDuplicates}
    </label>
  </fieldset>

  <section data-results hidden class="results">
    <div class="results-heading">
      <h3>{compare.results}</h3>

      <dl data-summary class="summary" hidden>
        <div class="summary-item">
          <dt>{compare.onlyInA}</dt>
          <dd data-summary-only-a>0</dd>
        </div>
        <div class="summary-item">
          <dt>{compare.inBoth}</dt>
          <dd data-summary-matches>0</dd>
        </div>
        <div class="summary-item">
          <dt>{compare.onlyInB}</dt>
          <dd data-summary-only-b>0</dd>
        </div>
      </dl>
    </div>

    <p data-empty-results>{compare.emptyResults}</p>

    <div class="results-controls">
      <div
        role="tablist"
        data-result-tabs
        class="tabs"
        aria-label={compare.results}
        hidden
      >
        {
          resultViews.map((view) => (
            <button
              type="button"
              role="tab"
              id={view.id}
              class="tab"
              aria-controls="result-panel"
              aria-selected={view.selected}
              tabindex={view.selected ? 0 : -1}
              data-result-tab={view.value}
            >
              {view.label}
            </button>
          ))
        }
      </div>

      <div class="result-toolbar">
        <h4 class="visually-hidden" data-result-heading>
          {compare.differences}
        </h4>
        <p class="panel-count" data-result-count>0 {compare.items}</p>
        <p
          class="local-feedback"
          data-local-feedback
          role="status"
          aria-live="polite"
          aria-atomic="true"
        >
        </p>
        <div class="result-actions">
          <button type="button" class="action" data-copy-result disabled>
            {compare.copy}
          </button>
          <button type="button" class="action" data-download-result disabled>
            {compare.download}
          </button>
        </div>
      </div>
    </div>

    <div
      role="tabpanel"
      id="result-panel"
      class="panel"
      aria-labelledby="tab-differences"
      data-result-panel
      hidden
    >
      <pre class="viewer" data-result-viewer tabindex="0"></pre>
    </div>
  </section>

  <noscript>
    <p class="noscript">{compare.noscript}</p>
  </noscript>
</section>

<script>
  import { mountCompareTool } from "../scripts/compare-tool";

  mountCompareTool();
</script>

<style>
  section[data-compare-tool] {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-2);
    padding: var(--space-4);
    border: var(--border-default);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .tool-heading {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    z-index: 1;
  }

  .example-button {
    min-height: 28px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-text-secondary);
    font: inherit;
    font-size: var(--font-size-body-secondary);
    line-height: var(--line-height-body-secondary);
    font-weight: var(--font-weight-control);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .example-button:hover:not(:disabled) {
    color: var(--color-accent);
  }

  .example-button:disabled {
    cursor: default;
    opacity: 0.55;
  }

  .lists {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    align-items: start;
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .list:last-child > label {
    padding-right: 88px;
  }

  .list label {
    font-size: var(--font-size-ui-label);
    line-height: var(--line-height-ui-label);
    font-weight: var(--font-weight-ui-label);
    letter-spacing: var(--letter-spacing-ui-label);
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .list textarea {
    width: 100%;
    min-height: 180px;
    padding: var(--space-3);
    border: var(--border-default);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--font-size-result-data);
    line-height: var(--line-height-result-data);
    resize: vertical;
  }

  .list textarea:hover {
    border-color: var(--color-border-strong);
  }

  .list textarea:focus-visible {
    outline: var(--focus-outline);
    outline-offset: var(--focus-outline-offset);
  }

  .list-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .list-footer output {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-secondary);
    line-height: var(--line-height-body-secondary);
  }

  .swap {
    justify-self: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
  }

  .swap-mark {
    font-size: 18px;
    line-height: 1;
  }

  .text-button {
    min-height: 36px;
    padding: var(--space-1) 0;
    border: none;
    background: transparent;
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-secondary);
    line-height: var(--line-height-body-secondary);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .text-button:hover:not(:disabled) {
    color: var(--color-accent);
  }

  .text-button:disabled {
    cursor: default;
    opacity: 0.55;
  }

  .options {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: var(--space-2) var(--space-3);
    border: 0;
    border-radius: var(--radius-md);
    background: var(--color-surface-muted);
  }

  .options-label {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-secondary);
    line-height: var(--line-height-body-secondary);
    font-weight: var(--font-weight-control);
  }

  .option {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-control);
    line-height: var(--line-height-control);
    font-weight: var(--font-weight-control);
    cursor: pointer;
  }

  .option input {
    width: 16px;
    height: 16px;
    margin: 0;
    accent-color: var(--color-accent);
  }

  .results {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: var(--border-default);
  }

  .results-heading {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
  }

  .results[hidden],
  .summary[hidden],
  .tabs[hidden],
  .panel[hidden] {
    display: none;
  }

  .results > p {
    margin: 0;
    color: var(--color-text-secondary);
  }

  .results h3 {
    margin: 0;
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    font-weight: var(--font-weight-h3);
  }

  .summary {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
    margin: 0;
  }

  .summary-item {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin: 0;
  }

  .summary-item dt {
    font-size: var(--font-size-ui-label);
    line-height: var(--line-height-ui-label);
    font-weight: var(--font-weight-ui-label);
    letter-spacing: var(--letter-spacing-ui-label);
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .summary-item dd {
    margin: 0;
    font-size: var(--font-size-summary-number);
    line-height: var(--line-height-summary-number);
    font-weight: var(--font-weight-summary-number);
  }

  .results-controls {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
    border-bottom: var(--border-default);
  }

  .tabs {
    display: flex;
    flex: 1 1 auto;
    flex-wrap: nowrap;
    gap: var(--space-1);
    min-width: 0;
    overflow-x: auto;
    padding-block: var(--space-1);
  }

  .tab {
    min-height: 36px;
    padding: var(--space-1) var(--space-3);
    border: none;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--color-text-secondary);
    font-size: var(--font-size-control);
    line-height: var(--line-height-control);
    font-weight: var(--font-weight-control);
    white-space: nowrap;
    cursor: pointer;
  }

  .tab:hover {
    color: var(--color-text);
  }

  .tab[aria-selected="true"] {
    color: var(--color-text);
    border-bottom-color: var(--color-accent);
  }

  .panel {
    display: flex;
    flex-direction: column;
  }

  .panel-count {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-secondary);
    line-height: var(--line-height-body-secondary);
  }

  .result-toolbar {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: var(--space-2);
  }

  .tabs[hidden] + .result-toolbar {
    display: none;
  }

  .result-actions {
    display: flex;
    gap: var(--space-2);
  }

  .action,
  .secondary {
    min-height: 36px;
    padding: var(--space-1) var(--space-3);
    border: var(--border-default);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--font-size-control);
    line-height: var(--line-height-control);
    font-weight: var(--font-weight-control);
    cursor: pointer;
  }

  .action:hover:not(:disabled),
  .secondary:hover:not(:disabled) {
    background: var(--color-surface-muted);
    border-color: var(--color-border-strong);
  }

  .action:focus-visible,
  .secondary:focus-visible,
  .text-button:focus-visible,
  .example-button:focus-visible {
    outline: var(--focus-outline);
    outline-offset: var(--focus-outline-offset);
  }

  .action:disabled,
  .secondary:disabled {
    cursor: default;
    opacity: 0.55;
  }

  .local-feedback {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-secondary);
    line-height: var(--line-height-body-secondary);
  }

  .viewer {
    margin: 0;
    min-height: 120px;
    max-height: 360px;
    max-width: 100%;
    padding: var(--space-3);
    border: var(--border-default);
    border-radius: var(--radius-md);
    background: var(--color-surface-muted);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--font-size-result-data);
    line-height: var(--line-height-result-data);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    overflow-y: auto;
  }

  .viewer:focus-visible {
    outline: var(--focus-outline);
    outline-offset: var(--focus-outline-offset);
  }

  .noscript {
    margin: 0;
    padding: var(--space-3);
    border: var(--border-default);
    border-radius: var(--radius-md);
    background: var(--color-surface-muted);
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-secondary);
    line-height: var(--line-height-body-secondary);
  }

  @media (pointer: coarse) {
    .action,
    .secondary,
    .tab,
    .text-button,
    .example-button,
    .option {
      min-height: 44px;
    }
  }

  @media (max-width: 759px) {
    .tool-heading {
      position: static;
      align-self: flex-end;
      height: 28px;
    }

    .list:last-child > label {
      padding-right: 0;
    }

    .swap-mark {
      transform: rotate(90deg);
    }

    .results-controls {
      align-items: stretch;
      flex-direction: column;
      gap: 0;
    }

    .result-toolbar {
      justify-content: flex-end;
      padding-block: var(--space-1) var(--space-2);
    }
  }

  @media (min-width: 760px) {
    section[data-compare-tool] {
      padding: var(--space-4) var(--space-5);
    }

    .lists {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
    }

    .list textarea {
      height: clamp(176px, 21vh, 224px);
      min-height: 176px;
    }

    .swap {
      width: 36px;
      padding-inline: 0;
    }

    .swap-label {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .viewer {
      max-height: 440px;
    }
  }
</style>
