---
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import type { ActiveLocale } from "@/i18n/locales";
import { routeFor } from "@/i18n/routes";
import type { PageKey, SiteLocaleContent } from "@/i18n/types";

interface Props {
  locale: ActiveLocale;
  content: SiteLocaleContent;
  pageKey?: PageKey;
}

const { locale, content, pageKey } = Astro.props;
const { header } = content;
---

<header class="header">
  <a href={routeFor(locale, "home")} class="wordmark">{content.siteName}</a>
  <div class="header-actions">
    <nav class="header-nav" aria-label={header.ariaLabel}>
      <a href={routeFor(locale, "tools")}>{header.tools}</a>
      <a href={routeFor(locale, "about")}>{header.about}</a>
    </nav>
    {
      pageKey && (
        <LanguageSwitcher
          locale={locale}
          pageKey={pageKey}
          ariaLabel={header.language}
        />
      )
    }
  </div>
</header>

<style>
  .header-actions,
  .header-nav {
    display: flex;
    align-items: center;
  }

  .header-actions {
    gap: var(--space-4);
  }

  .header-nav {
    gap: var(--space-4);
  }

  .header-nav a,
  .wordmark {
    color: var(--color-text);
    font-size: var(--font-size-control);
    line-height: var(--line-height-control);
    font-weight: var(--font-weight-control);
    text-decoration: none;
  }

  .header-nav a:hover,
  .wordmark:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .wordmark {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    font-weight: var(--font-weight-h3);
  }

  @media (max-width: 520px) {
    .header {
      flex-wrap: wrap;
    }

    .header-actions {
      max-width: 100%;
      margin-left: auto;
    }

    .header-nav {
      flex-wrap: wrap;
      justify-content: flex-end;
    }
  }

  @media (pointer: coarse) {
    .header-nav a,
    .wordmark {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>
