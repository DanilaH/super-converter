---
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import type { ActiveLocale } from "@/i18n/locales";
import { routeFor } from "@/i18n/routes";
import type { LocaleContent, PageKey } from "@/i18n/types";

interface Props {
  locale: ActiveLocale;
  content: LocaleContent;
  pageKey?: PageKey;
}

const { locale, content, pageKey } = Astro.props;
const { header } = content;
---

<header class="header">
  <a href={routeFor(locale, "home")} class="wordmark">{content.siteName}</a>
  <div class="header-actions">
    <nav class="header-nav" aria-label={header.ariaLabel}>
      <a href={routeFor(locale, "tools")}>{header.tools}</a>
      <a href={routeFor(locale, "about")}>{header.about}</a>
    </nav>
    {
      pageKey && (
        <LanguageSwitcher
          locale={locale}
          pageKey={pageKey}
          ariaLabel={header.language}
        />
      )
    }
  </div>
</header>

<style>
  .header-actions,
  .header-nav {
    display: flex;
    align-items: center;
  }

  .header-actions {
    gap: var(--space-3);
  }

  .header-nav {
    gap: var(--space-4);
  }

  .header-nav a {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-secondary);
    line-height: var(--line-height-body-secondary);
    font-weight: var(--font-weight-control);
    text-decoration: none;
  }

  .header-nav a:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 520px) {
    .header-actions {
      gap: var(--space-2);
    }

    .header-nav {
      gap: var(--space-3);
    }
  }

  @media (pointer: coarse) {
    .header-nav a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>
