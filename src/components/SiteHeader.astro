---
import { routeFor } from "@/i18n/routes";
import type { ActiveLocale } from "@/i18n/locales";
import type { LocaleContent } from "@/i18n/types";

interface Props {
  locale: ActiveLocale;
  content: LocaleContent;
}

const { locale, content } = Astro.props;
const { header } = content;
---

<header class="header">
  <a href={routeFor(locale, "home")} class="wordmark">{content.siteName}</a>
  <nav class="header-nav" aria-label={header.ariaLabel}>
    <a href={routeFor(locale, "tools")}>{header.tools}</a>
    <a href={routeFor(locale, "about")}>{header.about}</a>
  </nav>
</header>

<style>
  .header-nav {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .header-nav a {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-secondary);
    line-height: var(--line-height-body-secondary);
    font-weight: var(--font-weight-control);
    text-decoration: none;
  }

  .header-nav a:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (pointer: coarse) {
    .header-nav a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>
