---
import { englishContent } from "@/content/en";

const { footer } = englishContent;
---

<footer class="footer">
  <span class="footer-name">{englishContent.siteName}</span>
  <nav class="footer-nav" aria-label={footer.ariaLabel}>
    <a href="/#compare-tool-heading">{footer.tool}</a>
    <a href="/about">{footer.about}</a>
    <a href="/privacy">{footer.privacy}</a>
  </nav>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: var(--space-5);
    row-gap: var(--space-2);
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-4);
    row-gap: var(--space-2);
  }

  .footer-nav a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .footer-nav a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }
</style>
