---
import type { ActiveLocale } from "@/i18n/locales";
import { routeFor } from "@/i18n/routes";
import type { LocaleContent } from "@/i18n/types";

interface Props {
  locale: ActiveLocale;
  content: LocaleContent;
}

const { locale, content } = Astro.props;
const { footer } = content;
---

<footer class="footer">
  <span class="footer-name">{content.siteName}</span>
  <nav class="footer-nav" aria-label={footer.ariaLabel}>
    <a href={routeFor(locale, "home")}>{footer.compareLists}</a>
    <a href={routeFor(locale, "alphabetizeList")}>{footer.alphabetizer}</a>
    <a href={routeFor(locale, "randomizeList")}>{footer.randomizer}</a>
    <a href={routeFor(locale, "removeDuplicateLines")}>
      {footer.duplicateLines}
    </a>
    <a href={routeFor(locale, "about")}>{footer.about}</a>
    <a href={routeFor(locale, "privacy")}>{footer.privacy}</a>
  </nav>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: var(--space-5);
    row-gap: var(--space-2);
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-4);
    row-gap: var(--space-2);
  }

  .footer-nav a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .footer-nav a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  @media (pointer: coarse) {
    .footer-nav a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>
