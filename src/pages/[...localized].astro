---
import AlphabetizeTool from "@/components/AlphabetizeTool.astro";
import CompareTool from "@/components/CompareTool.astro";
import EditorialContent from "@/components/EditorialContent.astro";
import RandomizeTool from "@/components/RandomizeTool.astro";
import RelatedTools from "@/components/RelatedTools.astro";
import RemoveDuplicateLinesTool from "@/components/RemoveDuplicateLinesTool.astro";
import { contentFor } from "@/i18n/content";
import {
  ACTIVE_LOCALES,
  localeConfigFor,
  type ActiveLocale,
} from "@/i18n/locales";
import { relatedToolsFor } from "@/i18n/page";
import { routeFor } from "@/i18n/routes";
import {
  PAGE_KEYS,
  type PageKey,
  type ToolPageKey,
} from "@/i18n/types";
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  locale: ActiveLocale;
  pageKey: PageKey;
}

export function getStaticPaths() {
  return ACTIVE_LOCALES.filter((locale) => locale !== "en").flatMap((locale) =>
    PAGE_KEYS.map((pageKey) => {
      const route = routeFor(locale, pageKey);
      const localized = route.replace(/^\//, "").replace(/\/$/, "");
      return {
        params: { localized },
        props: { locale, pageKey },
      };
    }),
  );
}

function isToolPageKey(pageKey: PageKey): pageKey is ToolPageKey {
  return (
    pageKey === "home" ||
    pageKey === "alphabetizeList" ||
    pageKey === "randomizeList" ||
    pageKey === "removeDuplicateLines"
  );
}

const { locale, pageKey } = Astro.props;
const content = contentFor(locale);
const privacyHref = routeFor(locale, "privacy");
const relatedTools = isToolPageKey(pageKey)
  ? relatedToolsFor(locale, pageKey)
  : [];
const collatorLocale = localeConfigFor(locale).collatorLocale;
const toolOrder: readonly ToolPageKey[] = [
  "home",
  "alphabetizeList",
  "randomizeList",
  "removeDuplicateLines",
];
---

<BaseLayout metadataKey={pageKey} locale={locale}>
  {
    pageKey === "home" && (
      <>
        <div class="tool-intro">
          <h1>{content.home.heading}</h1>
          <p class="description">
            {content.home.description}
            <span class="privacy-note">{content.home.privacy}</span>
          </p>
          <CompareTool compare={content.compare} />
        </div>
        <EditorialContent
          content={content.editorial}
          privacyHref={privacyHref}
        />
        <RelatedTools
          heading={content.relatedTools.heading}
          tools={relatedTools}
        />
      </>
    )
  }

  {
    pageKey === "alphabetizeList" && (
      <>
        <div class="tool-intro">
          <h1>{content.alphabetizeList.page.heading}</h1>
          <p class="description">
            {content.alphabetizeList.page.description}
            <span class="privacy-note">
              {content.alphabetizeList.page.privacy}
            </span>
          </p>
          <AlphabetizeTool
            tool={content.alphabetizeList.tool}
            collatorLocale={collatorLocale}
          />
        </div>
        <EditorialContent
          content={content.alphabetizeList.editorial}
          privacyHref={privacyHref}
        />
        <RelatedTools
          heading={content.relatedTools.heading}
          tools={relatedTools}
        />
      </>
    )
  }

  {
    pageKey === "randomizeList" && (
      <>
        <div class="tool-intro">
          <h1>{content.randomizeList.page.heading}</h1>
          <p class="description">
            {content.randomizeList.page.description}
            <span class="privacy-note">
              {content.randomizeList.page.privacy}
            </span>
          </p>
          <RandomizeTool tool={content.randomizeList.tool} />
        </div>
        <EditorialContent
          content={content.randomizeList.editorial}
          privacyHref={privacyHref}
        />
        <RelatedTools
          heading={content.relatedTools.heading}
          tools={relatedTools}
        />
      </>
    )
  }

  {
    pageKey === "removeDuplicateLines" && (
      <>
        <div class="tool-intro">
          <h1>{content.removeDuplicateLines.page.heading}</h1>
          <p class="description">
            {content.removeDuplicateLines.page.description}
            <span class="privacy-note">
              {content.removeDuplicateLines.page.privacy}
            </span>
          </p>
          <RemoveDuplicateLinesTool tool={content.removeDuplicateLines.tool} />
        </div>
        <EditorialContent
          content={content.removeDuplicateLines.editorial}
          privacyHref={privacyHref}
        />
        <RelatedTools
          heading={content.relatedTools.heading}
          tools={relatedTools}
        />
      </>
    )
  }

  {
    pageKey === "tools" && (
      <div class="support-page tools-page">
        <h1>{content.toolsPage.heading}</h1>
        <p class="support-intro">{content.toolsPage.intro}</p>
        <nav aria-label={content.toolsPage.ariaLabel}>
          <ul class="tool-list">
            {toolOrder.map((toolPageKey) => {
              const item = content.toolsPage.items[toolPageKey];
              return (
                <li>
                  <a href={routeFor(locale, toolPageKey)}>{item.label}</a>
                  <p>{item.description}</p>
                </li>
              );
            })}
          </ul>
        </nav>
      </div>
    )
  }

  {
    pageKey === "about" && (
      <div class="support-page about-page">
        <h1>{content.about.heading}</h1>
        {content.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <p class="tool-link">
          <a
            class="button-link button-link--primary"
            href={routeFor(locale, "tools")}
          >
            {content.about.toolLinkLabel}
          </a>
        </p>
      </div>
    )
  }

  {
    pageKey === "privacy" && (
      <div class="support-page privacy-page">
        <h1>{content.privacy.heading}</h1>
        <p class="support-intro">{content.privacy.intro}</p>
        {content.privacy.sections.map((section) => (
          <section class="privacy-section">
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </section>
        ))}
        <p class="tool-link">
          <a class="button-link" href={routeFor(locale, "tools")}>
            {content.privacy.toolLinkLabel}
          </a>
        </p>
      </div>
    )
  }
</BaseLayout>

<style>
  .tool-intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block: var(--space-3) var(--space-5);
  }

  .tool-intro h1,
  .support-page h1 {
    margin: 0;
    font-size: var(--font-size-h1-mobile);
    line-height: var(--line-height-h1-mobile);
    font-weight: var(--font-weight-h1);
  }

  .description {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-1);
    margin: 0;
    max-width: var(--container-editorial);
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
  }

  .privacy-note,
  .support-intro,
  .tool-list p {
    color: var(--color-text-secondary);
  }

  .support-page {
    max-width: var(--container-editorial);
    padding-block: var(--space-4) var(--space-7);
  }

  .tools-page h1 {
    margin-block-end: var(--space-3);
  }

  .support-intro {
    margin-block: 0 var(--space-6);
  }

  .tool-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tool-list a {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    font-weight: var(--font-weight-h3);
  }

  .tool-list p {
    margin-block: var(--space-1) 0;
  }

  .about-page h1,
  .privacy-page h1 {
    margin-block-end: var(--space-4);
  }

  .about-page p,
  .privacy-page p {
    margin-block: 0 var(--space-4);
  }

  .privacy-page .support-intro {
    margin-block-end: var(--space-3);
  }

  .privacy-page h2 {
    margin-block: 0 var(--space-3);
    font-size: var(--font-size-h2-mobile);
    line-height: var(--line-height-h2-mobile);
    font-weight: var(--font-weight-h2);
  }

  .privacy-section + .privacy-section {
    margin-block-start: var(--space-6);
  }

  .privacy-section > :last-child {
    margin-block-end: 0;
  }

  .tool-link {
    margin-block-start: var(--space-5) !important;
    font-weight: var(--font-weight-control);
  }

  @media (min-width: 760px) {
    .tool-intro h1,
    .support-page h1 {
      font-size: var(--font-size-h1);
      line-height: var(--line-height-h1);
    }

    .privacy-page h2 {
      font-size: var(--font-size-h2);
      line-height: var(--line-height-h2);
    }
  }
</style>
