---
import { englishContent } from "@/content/en";
import BaseLayout from "@/layouts/BaseLayout.astro";

const { notFoundPage } = englishContent;
---

<BaseLayout metadataKey="notFound">
  <div class="not-found">
    <h1>{notFoundPage.heading}</h1>
    <p>{notFoundPage.explanation}</p>
    <p class="tool-link">
      <a href="/#compare-tool-heading">{notFoundPage.toolLinkLabel}</a>
    </p>
  </div>
</BaseLayout>

<style>
  .not-found {
    max-width: var(--container-editorial);
    padding-block: var(--space-6) var(--space-7);
  }

  .not-found h1 {
    margin-block: 0 var(--space-4);
    font-size: var(--font-size-h1-mobile);
    line-height: var(--line-height-h1-mobile);
    font-weight: var(--font-weight-h1);
  }

  @media (min-width: 760px) {
    .not-found h1 {
      font-size: var(--font-size-h1);
      line-height: var(--line-height-h1);
    }
  }

  .not-found p {
    margin-block: 0 var(--space-4);
  }

  .not-found .tool-link {
    margin-block-start: var(--space-5);
    font-weight: var(--font-weight-control);
  }
</style>
