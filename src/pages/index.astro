---
import CompareTool from "@/components/CompareTool.astro";
import EditorialContent from "@/components/EditorialContent.astro";
import RelatedTools from "@/components/RelatedTools.astro";
import { contentFor } from "@/i18n/content";
import { DEFAULT_LOCALE } from "@/i18n/locales";
import { relatedToolsFor } from "@/i18n/page";
import BaseLayout from "@/layouts/BaseLayout.astro";

const locale = DEFAULT_LOCALE;
const content = contentFor(locale);
const { home } = content;
const relatedTools = relatedToolsFor(locale, "home");
---

<BaseLayout metadataKey="home" locale={locale}>
  <div class="intro">
    <h1>{home.heading}</h1>
    <p class="description">
      {home.description}
      <span class="privacy">{home.privacy}</span>
    </p>

    <CompareTool compare={content.compare} />
  </div>

  <EditorialContent content={content.editorial} />
  <RelatedTools heading={content.relatedTools.heading} tools={relatedTools} />
</BaseLayout>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block: var(--space-3) var(--space-5);
  }

  .intro h1 {
    margin: 0;
    font-size: var(--font-size-h1-mobile);
    line-height: var(--line-height-h1-mobile);
    font-weight: var(--font-weight-h1);
  }

  @media (min-width: 760px) {
    .intro h1 {
      font-size: var(--font-size-h1);
      line-height: var(--line-height-h1);
    }
  }

  .description {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-1);
    margin: 0;
    max-width: var(--container-editorial);
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
  }

  .privacy {
    color: var(--color-text-secondary);
  }
</style>
