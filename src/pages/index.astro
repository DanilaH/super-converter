---
import CompareTool from "@/components/CompareTool.astro";
import EditorialContent from "@/components/EditorialContent.astro";
import { englishContent } from "@/content/en";
import BaseLayout from "@/layouts/BaseLayout.astro";

const { home } = englishContent;
---

<BaseLayout metadataKey="home">
  <div class="intro">
    <h1>{home.heading}</h1>
    <p class="description">{home.description}</p>
    <p class="privacy">{home.privacy}</p>

    <CompareTool />
  </div>

  <EditorialContent />
</BaseLayout>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block: var(--space-4) var(--space-6);
  }

  .intro h1 {
    margin: 0;
    font-size: var(--font-size-h1-mobile);
    line-height: var(--line-height-h1-mobile);
    font-weight: var(--font-weight-h1);
  }

  @media (min-width: 760px) {
    .intro h1 {
      font-size: var(--font-size-h1);
      line-height: var(--line-height-h1);
    }
  }

  .description {
    margin: 0;
    max-width: var(--container-editorial);
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
  }

  .privacy {
    margin: 0;
    max-width: var(--container-editorial);
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-secondary);
    line-height: var(--line-height-body-secondary);
  }
</style>
