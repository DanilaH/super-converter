---
import { contentFor } from "@/i18n/content";
import { DEFAULT_LOCALE } from "@/i18n/locales";
import { routeFor } from "@/i18n/routes";
import type { ToolPageKey } from "@/i18n/types";
import BaseLayout from "@/layouts/BaseLayout.astro";

const locale = DEFAULT_LOCALE;
const content = contentFor(locale);
const { toolsPage } = content;
const toolOrder: readonly ToolPageKey[] = [
  "home",
  "alphabetizeList",
  "randomizeList",
  "removeDuplicateLines",
];
---

<BaseLayout metadataKey="tools" locale={locale}>
  <div class="tools-page">
    <h1>{toolsPage.heading}</h1>
    <p class="intro">{toolsPage.intro}</p>

    <nav aria-label={toolsPage.ariaLabel}>
      <ul class="tool-list">
        {
          toolOrder.map((pageKey) => {
            const item = toolsPage.items[pageKey];
            return (
              <li>
                <a href={routeFor(locale, pageKey)}>{item.label}</a>
                <p>{item.description}</p>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</BaseLayout>

<style>
  .tools-page {
    max-width: var(--container-editorial);
    padding-block: var(--space-4) var(--space-7);
  }

  .tools-page h1 {
    margin-block: 0 var(--space-3);
    font-size: var(--font-size-h1-mobile);
    line-height: var(--line-height-h1-mobile);
    font-weight: var(--font-weight-h1);
  }

  .intro {
    margin-block: 0 var(--space-6);
    color: var(--color-text-secondary);
  }

  .tool-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tool-list a {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    font-weight: var(--font-weight-h3);
  }

  .tool-list p {
    margin-block: var(--space-1) 0;
    color: var(--color-text-secondary);
  }

  @media (min-width: 760px) {
    .tools-page h1 {
      font-size: var(--font-size-h1);
      line-height: var(--line-height-h1);
    }
  }
</style>
