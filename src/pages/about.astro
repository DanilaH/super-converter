---
import { contentFor } from "@/i18n/content";
import { DEFAULT_LOCALE } from "@/i18n/locales";
import { routeFor } from "@/i18n/routes";
import BaseLayout from "@/layouts/BaseLayout.astro";

const locale = DEFAULT_LOCALE;
const content = contentFor(locale);
const { about } = content;
---

<BaseLayout metadataKey="about" locale={locale}>
  <div class="about">
    <h1>{about.heading}</h1>
    {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    <p class="tool-link">
      <a
        class="button-link button-link--primary"
        href={routeFor(locale, "tools")}
      >
        {about.toolLinkLabel}
      </a>
    </p>
  </div>
</BaseLayout>

<style>
  .about {
    max-width: var(--container-editorial);
    padding-block: var(--space-4) var(--space-7);
  }

  .about h1 {
    margin-block: 0 var(--space-4);
    font-size: var(--font-size-h1-mobile);
    line-height: var(--line-height-h1-mobile);
    font-weight: var(--font-weight-h1);
  }

  @media (min-width: 760px) {
    .about h1 {
      font-size: var(--font-size-h1);
      line-height: var(--line-height-h1);
    }
  }

  .about p {
    margin-block: 0 var(--space-4);
  }

  .about .tool-link {
    margin-block-start: var(--space-5);
    font-weight: var(--font-weight-control);
  }
</style>
